<?xml version="1.0"?>
<!DOCTYPE workflow
[
	<!ENTITY PSLOT "TIGGE_from_HPSS">
	<!ENTITY CYCLE_THROTTLE "2">
	<!ENTITY TASK_THROTTLE "40">
	<!ENTITY TIGGE_PTMP "/scratch4/NCEPDEV/global/role.glopara/TIGGE/tigge_tmp">
	<!ENTITY GEFS_COM "&TIGGE_PTMP;/hpss">

	<!ENTITY MACHINE "ursa">
	<!ENTITY ACCOUNT "fv3-cpu">
	<!ENTITY SCHEDULER "slurm">
	<!ENTITY COMPUTE_QUEUE "batch">
	<!ENTITY TRANSFER_QUEUE "batch">
	<!ENTITY COMPUTE_PART "u1-compute">
	<!ENTITY TRANSFER_PART "u1-service">
	<!ENTITY DATABASE "hpss.db">
	<!ENTITY WORKFLOW "hpss.xml">

	<!ENTITY ENV_VARS SYSTEM "env_vars.xml">
	<!ENTITY pull_from_hpss SYSTEM "tasks/ursa/pull_from_hpss.xml">
	<!ENTITY link_input SYSTEM "tasks/ursa/link_input.xml">
	<!ENTITY process_tigge SYSTEM "tasks/ursa/process_tigge.xml">
	<!ENTITY transfer_output SYSTEM "tasks/ursa/transfer_output.xml">
	<!ENTITY archive_output SYSTEM "tasks/ursa/archive_output.xml">
	<!ENTITY handle_dead SYSTEM "tasks/ursa/handle_dead.xml">
	<!ENTITY cleanup SYSTEM "tasks/ursa/cleanup.xml">
]>

<workflow realtime="F" cyclethrottle="&CYCLE_THROTTLE;" scheduler="&SCHEDULER;" taskthrottle="&TASK_THROTTLE;">

	<log><cyclestr>&TIGGE_PTMP;/logs/@Y@m@d_@H/tigge_workflow.log</cyclestr></log>
	
	<!-- List as many different cycles definitions as needed -->
	<!-- <cycledef group="tigge">202412090000 202412090000 06:00:00</cycledef> -->
	<cycledef group="tigge">202509030600 202712310000 06:00:00</cycledef>

	&pull_from_hpss;
	&link_input;
	&process_tigge;
	&transfer_output;
	&archive_output;
	<!-- &handle_dead; -->
	&cleanup;

</workflow>
